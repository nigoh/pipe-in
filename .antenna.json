{
  "version": 1,
  "plugin": "pipe-in",
  "check": ["python3", "-m", "pytest", "-q"],
  "primary": [
    "https://code.claude.com/docs",
    "https://github.com/anthropics/claude-code/blob/main/CHANGELOG.md",
    "https://raw.githubusercontent.com/anthropics/claude-code/main/CHANGELOG.md",
    "https://github.com/anthropics/claude-agent-sdk-python/blob/main/CHANGELOG.md",
    "https://raw.githubusercontent.com/anthropics/claude-agent-sdk-python/main/CHANGELOG.md"
  ],
  "categories": [
    {
      "id": "claude-code-harness",
      "title": "Claude Code のハーネス",
      "want": "スキルとプラグインの書き方の決まりが変わったとき。SKILL.md の frontmatter、plugin.json の項目、スキルの説明文の書き方の指針",
      "targets": [
        "plugin/skills/pipe-build/SKILL.md",
        "plugin/skills/pipe-eval/SKILL.md",
        "plugin/skills/pipe-judge/SKILL.md",
        "plugin/skills/pipe-live/SKILL.md",
        "plugin/.claude-plugin/plugin.json"
      ],
      "sources": [
        "https://code.claude.com/docs/en/changelog",
        "https://code.claude.com/docs/en/skills",
        "https://code.claude.com/docs/en/plugins-reference"
      ],
      "explore": []
    },
    {
      "id": "plugin-guards",
      "title": "プラグインの守りに関わる部品",
      "want": "エージェントの定義（道具の一覧・モデル）と、会話の中でパイプを流すスキルに関わる、公式の決まりの変更。守りの範囲に関わるので、いつも人が見る",
      "mode": "pr",
      "targets": ["plugin/agents/*.md", "plugin/skills/pipe-run/SKILL.md"],
      "sources": ["https://code.claude.com/docs/en/sub-agents"],
      "explore": []
    },
    {
      "id": "agent-sdk",
      "title": "Claude Agent SDK",
      "want": "SDK の版が上がって、段を流す所（オプションの名前・メッセージの形・使用量の取り方）に関わる変更が出たとき。本体は決定の記録とテスト先行で直すので、いつも人が見る",
      "mode": "pr",
      "targets": ["pipe_in/engine/*.py", "pipe_in/usage/*.py", "pyproject.toml"],
      "sources": [
        "https://raw.githubusercontent.com/anthropics/claude-agent-sdk-python/main/CHANGELOG.md",
        "https://code.claude.com/docs/en/agent-sdk/overview"
      ],
      "explore": []
    }
  ],
  "apply": {
    "mode": "auto",
    "allow": [
      "plugin/skills/pipe-build/SKILL.md",
      "plugin/skills/pipe-eval/SKILL.md",
      "plugin/skills/pipe-judge/SKILL.md",
      "plugin/skills/pipe-live/SKILL.md",
      "plugin/.claude-plugin/plugin.json",
      "tests/**"
    ],
    "deny": [
      "pipe_in/engine/guard.py",
      "generator/guard_hook.py",
      "generator/chat_hook.py",
      "plugin/evals/**",
      "tests/conftest.py",
      "tests/fixtures/**"
    ],
    "tests": ["tests/**"],
    "max_lines": 60,
    "version_file": "plugin/.claude-plugin/plugin.json"
  }
}
