# Python
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
build/
dist/

# pipe-in を手元で流した記録（プロンプト・コードの中身・セッション ID・手元のパスを含む）
/docs/pipeline/

# 動画を作る見本のパイプ（examples/video/）を、このリポジトリを対象に流したときの出力（ロゴ・案・こま・MP4・選んだ記録）
/video/

# Claude Code の手元だけの設定と、機能ごとの worktree（python -m pipe_in worktree new が切る。D0047）
/.claude/worktrees/
.claude/settings.local.json
CLAUDE.local.md

# 秘密
.env
.env.*
*.pem
*.key

# OS・エディタ
.DS_Store
Thumbs.db

# 作ったパイプ（対象プロジェクトの事情が入りやすい）。README だけ追跡する
/pipes/*
!/pipes/README.md
# このリポジトリを対象にして作ったパイプ（.pipe-in/pipes/、前の版の .devpipe/pipes/）も載せない
/.pipe-in/
/.devpipe/

# プラグインの eval の結果（claude plugin eval の出力。利用料のかかる実行の記録）
/plugin/evals/results/

# Playwright（MCP）で画面を確かめたときのスクリーンショット
.playwright-mcp/
