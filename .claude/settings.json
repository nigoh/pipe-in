{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(npm test:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run build:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(npm --prefix vscode test)",
      "Bash(npm --prefix vscode run typecheck)",
      "Bash(npm --prefix vscode run build)",
      "Bash(npm --prefix vscode run preview)",
      "Bash(python -m http.server 8765 --bind 127.0.0.1 --directory vscode/out/preview)",
      "Bash(python -m pipe_in skill:*)",
      "Bash(python --version)",
      "Bash(npm --prefix vscode ci)",
      "Agent(pipe-in-analyst)",
      "Agent(pipe-in-tester)",
      "Agent(pipe-in-coder)",
      "Agent(pipe-in-verifier)",
      "Agent(pipe-in-auditor)",
      "Agent(pipe-in-advisor)",
      "Agent(pipe-in-judge)",
      "Agent(pipe-in-documenter)"
    ],
    "ask": [
      "Bash(git merge:*)",
      "Bash(gh pr merge:*)",
      "Bash(npm publish:*)",
      "Bash(npx vsce publish:*)",
      "Bash(twine upload:*)",
      "Bash(gh issue create:*)",
      "Bash(git push)",
      "Bash(git push origin)",
      "Bash(git push * origin)",
      "Bash(git push * HEAD)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push */main)",
      "Bash(git push */main *)",
      "Bash(git push *+*)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *--delete*)",
      "Bash(git push * :**)",
      "Bash(git push *--all*)",
      "Bash(git push *--mirror*)",
      "Bash(git -* push*)",
      "Bash(gh api *merge*)",
      "Bash(gh api *refs/heads/main*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/pipe_in_guard.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/docs_reminder.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
