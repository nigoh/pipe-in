{
  "name": "pipe-in-vscode",
  "displayName": "pipe-in",
  "description": "pipe-in の実行を VSCode の中で図として見て、パイプを作業台で組み立てる",
  "version": "0.0.0",
  "publisher": "nok",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nigoh/pipe-in"
  },
  "private": true,
  "type": "module",
  "main": "./out/extension.cjs",
  "engines": {
    "node": ">=22",
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "pipe-in.showRun",
        "title": "pipe-in: 実行を見る",
        "icon": "$(circuit-board)"
      },
      {
        "command": "pipe-in.editPipe",
        "title": "pipe-in: パイプ作業台を開く",
        "icon": "$(type-hierarchy)"
      }
    ],
    "configuration": {
      "title": "pipe-in",
      "properties": {
        "pipe-in.workDir": {
          "type": "string",
          "default": "docs/pipeline",
          "description": "pipe-in の work_dir。ワークスペースの最初のフォルダからの相対パス"
        },
        "pipe-in.pipesDir": {
          "type": "string",
          "default": "",
          "description": "作業台で読み書きするパイプの置き場所。ワークスペースの最初のフォルダからの相対パスか、絶対パス。空なら .pipe-in/pipes と前の版の置き場所（どちらも無くて pipes があれば pipes）"
        },
        "pipe-in.showOtherWorktrees": {
          "type": "boolean",
          "default": true,
          "description": "同じ git リポジトリの別の worktree の実行も一覧に出す。切ると、いまの work_dir の実行だけ"
        }
      }
    }
  },
  "scripts": {
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "typecheck": "tsc -p .",
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.cjs && esbuild src/webview/pipeEditor.ts --bundle --platform=browser --format=iife --outfile=out/pipeEditor.js",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license -o pipe-in-vscode.vsix",
    "preview": "node --experimental-strip-types --no-warnings scripts/preview.ts"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7"
  }
}
