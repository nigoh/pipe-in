{
  "name": "devpipe-vscode",
  "displayName": "devpipe",
  "description": "devpipe の実行を VSCode の中で図として見る",
  "version": "0.0.0",
  "publisher": "nok",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/nigoh/devpipe" },
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./out/extension.cjs",
  "engines": {
    "node": ">=22",
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "devpipe.showRun",
        "title": "devpipe: 実行を見る",
        "icon": "$(circuit-board)"
      }
    ],
    "configuration": {
      "title": "devpipe",
      "properties": {
        "devpipe.workDir": {
          "type": "string",
          "default": "docs/pipeline",
          "description": "devpipe の work_dir。ワークスペースの最初のフォルダからの相対パス"
        }
      }
    }
  },
  "scripts": {
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "typecheck": "tsc -p .",
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.cjs",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license -o devpipe-vscode.vsix"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.24",
    "typescript": "^5.7"
  }
}
