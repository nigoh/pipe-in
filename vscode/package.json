{
  "name": "devpipe-vscode",
  "displayName": "devpipe",
  "description": "devpipe の実行を VSCode の中で図として見て、パイプを作図台で組み立てる",
  "version": "0.0.0",
  "publisher": "nok",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nigoh/devpipe"
  },
  "private": true,
  "type": "module",
  "main": "./out/extension.cjs",
  "engines": {
    "node": ">=22",
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "devpipe.showRun",
        "title": "devpipe: 実行を見る",
        "icon": "$(circuit-board)"
      },
      {
        "command": "devpipe.editPipe",
        "title": "devpipe: パイプを作図する",
        "icon": "$(type-hierarchy)"
      }
    ],
    "configuration": {
      "title": "devpipe",
      "properties": {
        "devpipe.workDir": {
          "type": "string",
          "default": "docs/pipeline",
          "description": "devpipe の work_dir。ワークスペースの最初のフォルダからの相対パス"
        },
        "devpipe.pipesDir": {
          "type": "string",
          "default": "",
          "description": "作図台で読み書きするパイプの置き場所。ワークスペースの最初のフォルダからの相対パスか、絶対パス。空なら .devpipe/pipes（無くて pipes があれば pipes）"
        }
      }
    }
  },
  "scripts": {
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "typecheck": "tsc -p .",
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.cjs && esbuild src/webview/pipeEditor.ts --bundle --platform=browser --format=iife --outfile=out/pipeEditor.js",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license -o devpipe-vscode.vsix",
    "preview": "node --experimental-strip-types --no-warnings scripts/preview.ts"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7"
  }
}
